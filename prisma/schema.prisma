generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum EventNewsType {
  EVENT
  NEWS
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MembershipStatus {
  NEW
  REVIEWED
  CONTACTED
  APPROVED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model AdminUser {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String?
  role            AdminRole     @default(SUPER_ADMIN)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdMedia    MediaAsset[]  @relation("MediaCreatedBy")
  updatedSettings SiteSetting[] @relation("SettingUpdatedBy")
}

model EventNews {
  id           String            @id @default(cuid())
  type         EventNewsType
  title        String
  slug         String            @unique
  excerpt      String?
  body         String
  category     String?
  coverMediaId String?
  eventStart   DateTime?
  eventEnd     DateTime?
  location     String?
  externalUrl  String?
  featured     Boolean           @default(false)
  status       PublicationStatus @default(DRAFT)
  publishedAt  DateTime?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  coverMedia   MediaAsset?       @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  galleryItems GalleryItem[]

  @@index([type, status, publishedAt])
  @@index([featured, sortOrder])
  @@index([eventStart])
}

model MediaAsset {
  id               String             @id @default(cuid())
  storageKey       String             @unique
  publicUrl        String?
  mediaType        MediaType
  mimeType         String?
  fileSize         Int?
  width            Int?
  height           Int?
  duration         Int?
  altText          String?
  caption          String?
  thumbnailId      String?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  thumbnail        MediaAsset?        @relation("MediaThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  thumbnails       MediaAsset[]       @relation("MediaThumbnail")
  createdBy        AdminUser?         @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  eventCovers      EventNews[]        @relation("EventCoverMedia")
  galleryItems     GalleryItem[]      @relation("GalleryMedia")
  leadershipPhotos LeadershipMember[] @relation("LeadershipPhoto")

  @@index([mediaType, createdAt])
  @@index([createdById])
}

model GalleryItem {
  id          String     @id @default(cuid())
  mediaId     String
  title       String?
  caption     String?
  category    String?
  eventNewsId String?
  sortOrder   Int        @default(0)
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  media       MediaAsset @relation("GalleryMedia", fields: [mediaId], references: [id], onDelete: Restrict)
  eventNews   EventNews? @relation(fields: [eventNewsId], references: [id], onDelete: SetNull)

  @@index([published, sortOrder])
  @@index([eventNewsId])
}

model LeadershipMember {
  id           String      @id @default(cuid())
  name         String
  designation  String
  bio          String?
  photoMediaId String?
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  photoMedia   MediaAsset? @relation("LeadershipPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
}

model MembershipApplication {
  id            String           @id @default(cuid())
  fullName      String
  fatherName    String
  phone         String
  email         String
  address       String?
  message       String?
  customData    Json             @default("{}")
  formVersion   Int              @default(1)
  status        MembershipStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model ContactMessage {
  id            String               @id @default(cuid())
  name          String
  email         String
  subject       String
  message       String
  status        ContactMessageStatus @default(NEW)
  internalNotes String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model SiteSetting {
  id          String     @id @default(cuid())
  key         String     @unique
  value       Json
  valueType   String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  updatedBy   AdminUser? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}
